# Where the Student API lives (no trailing slash). Locally: http://localhost:5000
API_BASE_URL=https://YOUR-SERVICE.onrender.com

# "stdio" (Claude Desktop / Claude Code on your own machine) or "http" (hosted, for cloud Claude)
MCP_TRANSPORT=stdio

# Required when MCP_TRANSPORT=http. Long random string; clients send it as "Authorization: Bearer <token>".
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# true = only expose read tools (list, get, stats, health). Recommended until you trust the setup.
MCP_READ_ONLY=false

# Port for http mode (Render sets this automatically)
PORT=3001
